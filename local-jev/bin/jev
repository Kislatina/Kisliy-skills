#!/usr/bin/env python3
"""jev — a local System One decision engine for Claude Code.

Typed decisions (choice / score / yes-no) with per-option probabilities and a
confidence number, computed on this Mac by a small local LLM served by Ollama.
The model never writes prose: it is asked for ONE label and we read the
probability distribution over the labels from its first-token logprobs.

Python 3.9+, standard library only.
"""
import argparse
import concurrent.futures as cf
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434")
if not HOST.startswith("http"):
    HOST = "http://" + HOST
CONFIG = os.path.expanduser("~/.config/local-jev/config.json")
KEEP_ALIVE = os.environ.get("JEV_KEEP_ALIVE", "30m")

# --------------------------------------------------------------------------
# Catalog: the ten local decision models.  tier: reflex < core < specialist.
# --------------------------------------------------------------------------
CATALOG = [
    {"id": "llama3.2:3b", "name": "Llama 3.2 3B", "gb": 2.0, "ram": 6, "tier": "reflex",
     "why": "Fastest sane router. Intent routing, language/spam/topic tagging on 8 GB Macs."},
    {"id": "qwen3:4b-instruct-2507-q4_K_M", "name": "Qwen3 4B Instruct 2507", "gb": 2.5, "ram": 8, "tier": "reflex",
     "why": "Best accuracy under 3 GB; follows label-only instructions and holds up on multilingual text."},
    {"id": "phi4-mini:3.8b", "name": "Phi-4 mini 3.8B", "gb": 2.5, "ram": 8, "tier": "reflex",
     "why": "Strong at logic-flavoured yes/no checks, rubrics and code-adjacent questions for its size."},
    {"id": "gemma3:4b", "name": "Gemma 3 4B", "gb": 3.4, "ram": 8, "tier": "reflex",
     "why": "Well-calibrated probabilities for its size; good second voice in a panel."},
    {"id": "qwen3:8b", "name": "Qwen3 8B", "gb": 5.2, "ram": 12, "tier": "core",
     "why": "The default. Best all-round balance of accuracy, calibration and ~0.3 s decisions on Apple Silicon."},
    {"id": "granite3.3:8b", "name": "IBM Granite 3.3 8B", "gb": 4.9, "ram": 12, "tier": "core",
     "why": "Enterprise-tuned for classification, extraction and policy checks; very terse and predictable."},
    {"id": "gemma3:12b", "name": "Gemma 3 12B", "gb": 8.2, "ram": 16, "tier": "core",
     "why": "Nuanced scoring and tone/sentiment rubrics; strongest non-Chinese-lab model in this size band."},
    {"id": "qwen3:14b", "name": "Qwen3 14B", "gb": 9.3, "ram": 24, "tier": "core",
     "why": "Highest accuracy of the single-model picks; use when a wrong decision is expensive."},
    {"id": "phi4:14b", "name": "Phi-4 14B", "gb": 9.1, "ram": 24, "tier": "core",
     "why": "Excellent on reasoning-heavy gates (is this diff safe, does the evidence support the claim)."},
    {"id": "granite3-guardian:8b", "name": "Granite Guardian 3 8B", "gb": 5.8, "ram": 12, "tier": "specialist",
     "why": "Purpose-built risk detector: harm, jailbreak, bias, violence, profanity. Use via `jev guard`."},
]
# System-2 companions: slow reasoning models, used with `jev think` (not logprob decisions).
THINKERS = [
    {"id": "deepseek-r1:14b", "name": "DeepSeek-R1 14B", "gb": 9.0, "ram": 24},
    {"id": "deepseek-r1:8b", "name": "DeepSeek-R1 8B", "gb": 5.2, "ram": 12},
    {"id": "gpt-oss:20b", "name": "gpt-oss 20B", "gb": 13.8, "ram": 24},
]
ALIASES = {"tiny": "llama3.2:3b", "fast": "qwen3:4b-instruct-2507-q4_K_M", "default": "qwen3:8b",
           "best": "qwen3:14b", "guard": "granite3-guardian:8b", "think": "deepseek-r1:8b"}


def die(msg, code=1):
    print("jev: " + msg, file=sys.stderr)
    sys.exit(code)


def ram_gb():
    try:
        return int(subprocess.check_output(["sysctl", "-n", "hw.memsize"]).strip()) / 2 ** 30
    except Exception:
        return 0.0


def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except Exception:
        return {}


def default_model():
    env = os.environ.get("JEV_MODEL")
    if env:
        return resolve(env)
    cfg = load_config().get("model")
    if cfg:
        return cfg
    r = ram_gb()
    if r >= 32:
        return "qwen3:14b"
    if r >= 12:
        return "qwen3:8b"
    return "qwen3:4b-instruct-2507-q4_K_M"


def resolve(name):
    return ALIASES.get(name, name)


# --------------------------------------------------------------------------
# Ollama HTTP
# --------------------------------------------------------------------------
def http(path, body=None, timeout=120):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(HOST + path, data=data, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def server_up():
    try:
        http("/api/version", timeout=2)
        return True
    except Exception:
        return False


def installed_models():
    try:
        return [m["name"] for m in http("/api/tags", timeout=3).get("models", [])]
    except Exception:
        return []


def has_model(tag, installed):
    return any(i == tag or i == tag + ":latest" or (":" not in tag and i.startswith(tag + ":")) for i in installed)


def chat(model, messages, num_predict=1, logprobs=True, think=False, timeout=180):
    body = {"model": model, "messages": messages, "stream": False, "keep_alive": KEEP_ALIVE,
            "options": {"temperature": 0, "seed": 7, "num_predict": num_predict}}
    if logprobs:
        body["logprobs"] = True
        body["top_logprobs"] = 20
    if think is not None:
        body["think"] = think
    try:
        return http("/api/chat", body, timeout)
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")
        if e.code == 400 and "think" in detail and "think" in body:
            body.pop("think")  # model has no thinking switch
            return http("/api/chat", body, timeout)
        if e.code == 404:
            die("model '%s' is not installed. Run: jev pull %s" % (model, model), 4)
        die("ollama error %s: %s" % (e.code, detail[:300]))
    except urllib.error.URLError:
        die("Ollama is not running at %s. Run: jev setup" % HOST, 4)


def first_token_logprobs(resp):
    lp = resp.get("logprobs")
    if lp is None:
        lp = (resp.get("message") or {}).get("logprobs")
    if not lp:
        return None
    first = lp[0]
    tops = first.get("top_logprobs") or [first]
    return [(t.get("token", ""), t.get("logprob", -99.0)) for t in tops]


# --------------------------------------------------------------------------
# The decision core
# --------------------------------------------------------------------------
SYSTEM = ("You are a fast decision engine inside a software pipeline. Read the STATE, then answer the QUESTION by "
          "replying with exactly one label from the list and nothing else. Never explain.")


def render_state(state):
    if isinstance(state, str):
        return state.strip()
    return json.dumps(state, ensure_ascii=False, indent=2)


def distribution(model, state, question, labels, lines, instructions=None, word_labels=False):
    """Return (probs{label:p}, mass_on_valid_labels, raw_text)."""
    sys_text = SYSTEM + ("\n" + instructions.strip() if instructions else "")
    user = "STATE:\n%s\n\nQUESTION: %s\n\nLABELS:\n%s\n\nAnswer with the label only." % (
        render_state(state), question, "\n".join(lines))
    resp = chat(model, [{"role": "system", "content": sys_text}, {"role": "user", "content": user}])
    text = ((resp.get("message") or {}).get("content") or "").strip()
    tops = first_token_logprobs(resp)
    raw = {l: 0.0 for l in labels}
    if tops:
        for tok, lp in tops:
            t = tok.strip()
            for l in labels:
                if (t.lower() == l.lower()) if word_labels else (t == l):
                    raw[l] += math.exp(lp)
                    break
    mass = sum(raw.values())
    if mass < 0.2:
        # No usable logprobs (old Ollama / odd tokenizer): fall back to the written answer.
        retry = chat(model, [{"role": "system", "content": sys_text}, {"role": "user", "content": user}],
                     num_predict=12, logprobs=False)
        text = ((retry.get("message") or {}).get("content") or "").strip()
        head = re.sub(r"^[^\w]+", "", text)
        for l in labels:
            if head.lower().startswith(l.lower()):
                raw = {k: (1.0 if k == l else 0.0) for k in labels}
                mass = 0.0
                break
    total = sum(raw.values())
    if total <= 0:
        return None, 0.0, text
    return {l: raw[l] / total for l in labels}, min(1.0, mass), text


def conf_choice(ps):
    n = len(ps)
    if n < 2:
        return 1.0
    return max(0.0, min(1.0, (n * max(ps) - 1) / (n - 1)))


def conf_score(ps):
    n = len(ps)
    peak = ps.index(max(ps))
    spread = sum(p * abs(i - peak) for i, p in enumerate(ps))
    even = sum(abs(i - (n - 1) / 2.0) for i in range(n)) / n
    return max(0.0, min(1.0, 1 - spread / even)) if even else 1.0


def norm_options(options):
    """Accept ['a','b'] or {'a': 'description', ...} -> (names, descriptions)."""
    if isinstance(options, dict):
        return list(options.keys()), [str(v) for v in options.values()]
    names = [str(o) for o in options]
    return names, [""] * len(names)


def letters(n):
    return [chr(ord("A") + i) for i in range(n)]


def do_choice(model, state, question, options, instructions=None, debias=False):
    names, descs = norm_options(options)
    if len(names) < 2 or len(names) > 26:
        die("choice needs 2-26 options")
    runs = [list(range(len(names)))]
    if debias:
        runs.append(list(reversed(range(len(names)))))
    acc = [0.0] * len(names)
    mass_sum, text = 0.0, ""
    for order in runs:
        labs = letters(len(names))
        lines = []
        for slot, idx in enumerate(order):
            lines.append("%s) %s%s" % (labs[slot], names[idx], (" — " + descs[idx]) if descs[idx] else ""))
        probs, mass, text = distribution(model, state, question, labs, lines, instructions)
        if probs is None:
            return {"type": "choice", "choice": None, "error": "model gave no usable answer", "raw": text}
        for slot, idx in enumerate(order):
            acc[idx] += probs[labs[slot]] / len(runs)
        mass_sum += mass / len(runs)
    ps = acc
    best = max(range(len(ps)), key=lambda i: ps[i])
    return {"type": "choice", "choice": names[best],
            "probabilities": {n: round(p, 4) for n, p in zip(names, ps)},
            "confidence": round(conf_choice(ps), 4), "label_mass": round(mass_sum, 3)}


def do_score(model, state, question, levels, instructions=None):
    names, descs = norm_options(levels)
    if len(names) < 2 or len(names) > 10:
        die("score needs 2-10 levels")
    labs = [str(i) for i in range(len(names))]
    lines = ["%d = %s%s" % (i, names[i], (" — " + descs[i]) if descs[i] else "") for i in range(len(names))]
    probs, mass, text = distribution(model, state, question, labs, lines, instructions)
    if probs is None:
        return {"type": "score", "score": None, "error": "model gave no usable answer", "raw": text}
    ps = [probs[l] for l in labs]
    return {"type": "score", "score": round(sum(i * p for i, p in enumerate(ps)), 3),
            "level": max(range(len(ps)), key=lambda i: ps[i]), "levels": names,
            "probabilities": {str(i): round(p, 4) for i, p in enumerate(ps)},
            "confidence": round(conf_score(ps), 4), "label_mass": round(mass, 3)}


def do_noul(model, state, statement, instructions=None):
    q = "Is the following statement true of the STATE? Statement: " + statement
    probs, mass, text = distribution(model, state, q, ["Yes", "No"], ["Yes — the statement is true", "No — it is not"],
                                     instructions, word_labels=True)
    if probs is None:
        return {"type": "noul", "noul": None, "error": "model gave no usable answer", "raw": text}
    return {"type": "noul", "noul": round(probs["Yes"], 4), "answer": probs["Yes"] >= 0.5,
            "confidence": round(conf_choice([probs["Yes"], probs["No"]]), 4), "label_mass": round(mass, 3)}


def run_question(model, state, q, debias=False):
    t = q.get("type", "choice")
    ins = q.get("instructions")
    if t == "choice":
        out = do_choice(model, state, q["question"], q["options"], ins, q.get("debias", debias))
    elif t == "score":
        out = do_score(model, state, q["question"], q["levels"], ins)
    elif t in ("noul", "yesno"):
        out = do_noul(model, state, q.get("statement") or q["question"], ins)
    else:
        die("unknown question type: %s" % t)
    if "id" in q:
        out["id"] = q["id"]
    return out


def gate(out, min_conf):
    if min_conf is None:
        return out
    c = out.get("confidence")
    out["action"] = "act" if (c is not None and c >= min_conf) else "escalate"
    return out


def emit(obj, code=0):
    print(json.dumps(obj, ensure_ascii=False, indent=2))
    sys.exit(code)


def read_state(args):
    if getattr(args, "state_file", None):
        with open(args.state_file) as f:
            txt = f.read()
    elif getattr(args, "state", None) is not None:
        txt = args.state
    elif not sys.stdin.isatty():
        txt = sys.stdin.read()
    else:
        die("no state: pass --state, --state-file or pipe it on stdin")
    try:
        parsed = json.loads(txt)
        if isinstance(parsed, (dict, list)):
            return parsed
    except Exception:
        pass
    return txt


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
def cmd_choose(a):
    state = read_state(a)
    out = do_choice(resolve(a.model) if a.model else default_model(), state, a.question, a.option, a.instructions, a.debias)
    out = gate(out, a.min_confidence)
    emit(out, 3 if out.get("action") == "escalate" else 0)


def cmd_score(a):
    state = read_state(a)
    out = do_score(resolve(a.model) if a.model else default_model(), state, a.question, a.level, a.instructions)
    out = gate(out, a.min_confidence)
    emit(out, 3 if out.get("action") == "escalate" else 0)


def cmd_yesno(a):
    state = read_state(a)
    out = do_noul(resolve(a.model) if a.model else default_model(), state, a.statement, a.instructions)
    out = gate(out, a.min_confidence)
    emit(out, 3 if out.get("action") == "escalate" else 0)


def cmd_ask(a):
    """Batch fan-out: JSON {state, questions:[...]} on stdin or --file."""
    spec = json.load(open(a.file)) if a.file else json.load(sys.stdin)
    model = resolve(a.model) if a.model else default_model()
    qs = spec["questions"]
    with cf.ThreadPoolExecutor(max_workers=a.parallel) as ex:
        results = list(ex.map(lambda q: gate(run_question(model, spec["state"], q, a.debias), a.min_confidence), qs))
    escalate = any(r.get("action") == "escalate" for r in results)
    emit({"model": model, "results": results}, 3 if escalate else 0)


def cmd_panel(a):
    """Several models vote; probabilities are averaged; agreement is reported."""
    state = read_state(a)
    models = [resolve(m) for m in (a.models.split(",") if a.models else [default_model(), "gemma3:4b", "granite3.3:8b"])]
    installed = installed_models()
    models = [m for m in models if has_model(m, installed)]
    if len(models) < 2:
        die("panel needs at least 2 installed models (see: jev models)")
    names, _ = norm_options(a.option)
    runs = []
    for m in models:  # sequential: RAM-friendly, Ollama swaps models
        r = do_choice(m, state, a.question, a.option, a.instructions)
        if r.get("choice"):
            runs.append((m, r))
    avg = {n: sum(r["probabilities"][n] for _, r in runs) / len(runs) for n in names}
    best = max(avg, key=avg.get)
    votes = {m: r["choice"] for m, r in runs}
    agree = sum(1 for v in votes.values() if v == best) / len(votes)
    out = {"type": "panel", "choice": best, "probabilities": {k: round(v, 4) for k, v in avg.items()},
           "confidence": round(conf_choice(list(avg.values())) * agree, 4), "agreement": round(agree, 3), "votes": votes}
    out = gate(out, a.min_confidence)
    emit(out, 3 if out.get("action") == "escalate" else 0)


def cmd_guard(a):
    """Granite Guardian risk check. Output: probability the text is risky."""
    text = read_state(a)
    model = resolve(a.model) if a.model else "granite3-guardian:8b"
    resp = chat(model, [{"role": "system", "content": a.risk}, {"role": "user", "content": render_state(text)}],
                num_predict=1)
    tops = first_token_logprobs(resp) or []
    yes = sum(math.exp(lp) for t, lp in tops if t.strip().lower() == "yes")
    no = sum(math.exp(lp) for t, lp in tops if t.strip().lower() == "no")
    if yes + no == 0:
        die("guardian returned no Yes/No (got %r)" % (resp.get("message") or {}).get("content"))
    p = yes / (yes + no)
    out = {"type": "guard", "risk": a.risk, "risky": p >= 0.5, "probability": round(p, 4),
           "confidence": round(conf_choice([p, 1 - p]), 4)}
    emit(gate(out, a.min_confidence), 0)


def cmd_think(a):
    """System-2 escalation: let a reasoning model deliberate and print its answer."""
    model = resolve(a.model) if a.model else "deepseek-r1:8b"
    q = a.question if a.question else sys.stdin.read()
    resp = chat(model, [{"role": "user", "content": q}], num_predict=a.max_tokens, logprobs=False, think=True, timeout=900)
    msg = resp.get("message") or {}
    if a.show_thinking and msg.get("thinking"):
        print("--- thinking ---\n" + msg["thinking"] + "\n--- answer ---")
    print((msg.get("content") or "").strip())


BENCH = [
    ("I was charged twice for my subscription this month", "billing"),
    ("Please send me an invoice for last quarter", "billing"),
    ("My card was declined but the money left my account", "billing"),
    ("Can I get a refund for the annual plan?", "billing"),
    ("The app crashes every time I open the export screen", "technical"),
    ("API returns 502 when I upload files larger than 10MB", "technical"),
    ("Sync stopped working after the latest update", "technical"),
    ("Dark mode makes the text unreadable on my iPad", "technical"),
    ("I can't log in, the reset email never arrives", "account"),
    ("How do I change the email address on my profile?", "account"),
    ("Please delete my account and all my data", "account"),
    ("I want to add my colleague as an admin of our workspace", "account"),
    ("Do you offer discounts for 200 seats?", "sales"),
    ("We'd like a demo of the enterprise tier next week", "sales"),
    ("What's the difference between Pro and Team pricing?", "sales"),
    ("Can you integrate with our SSO provider? We're evaluating vendors", "sales"),
]


def cmd_bench(a):
    models = [resolve(m) for m in a.models.split(",")] if a.models else [default_model()]
    opts = ["billing", "technical", "account", "sales"]
    if not a.bare:  # descriptions matter a lot: bare names were ambiguous (sales vs billing)
        opts = {"billing": "charges, invoices, payments, refunds", "technical": "bugs, crashes, errors, performance",
                "account": "login, profile, permissions, data deletion", "sales": "pricing, demos, plans, evaluation"}
    rows = []
    for m in models:
        ok, confs, hi_ok, hi_n, t0 = 0, [], 0, 0, time.time()
        chat(m, [{"role": "user", "content": "hi"}], num_predict=1, logprobs=False)  # warm-up
        t0 = time.time()
        for text, gold in BENCH:
            r = do_choice(m, text, "Which team should handle this customer message?", opts, debias=a.debias)
            good = r.get("choice") == gold
            c = r.get("confidence") or 0
            ok += good
            confs.append(c)
            if c >= 0.7:
                hi_n += 1
                hi_ok += good
        ms = (time.time() - t0) * 1000 / len(BENCH)
        rows.append({"model": m, "accuracy": round(ok / len(BENCH), 3), "mean_confidence": round(sum(confs) / len(confs), 3),
                     "accuracy_when_conf>=0.7": round(hi_ok / hi_n, 3) if hi_n else None, "answered_conf>=0.7": hi_n,
                     "ms_per_decision": round(ms)})
    emit({"items": len(BENCH), "results": rows})


def cmd_models(a):
    r = ram_gb()
    installed = installed_models() if server_up() else []
    print("This Mac: %.0f GB RAM   default model: %s\n" % (r, default_model()))
    print("%-34s %6s %5s  %-10s %s" % ("MODEL", "SIZE", "RAM", "TIER", "WHAT IT IS FOR"))
    for m in CATALOG:
        mark = "●" if has_model(m["id"], installed) else " "
        fit = "" if r >= m["ram"] else "  (tight on this Mac)"
        print("%s %-32s %4.1fGB %3dGB  %-10s %s%s" % (mark, m["id"], m["gb"], m["ram"], m["tier"], m["why"], fit))
    print("\nSystem-2 companions (for `jev think`):")
    for m in THINKERS:
        mark = "●" if has_model(m["id"], installed) else " "
        print("%s %-32s %4.1fGB %3dGB" % (mark, m["id"], m["gb"], m["ram"]))
    print("\n● = installed. Shortcuts: " + ", ".join("%s=%s" % kv for kv in ALIASES.items()))


def ollama_bin():
    p = shutil.which("ollama")
    for c in ("/opt/homebrew/bin/ollama", "/usr/local/bin/ollama", "/Applications/Ollama.app/Contents/Resources/ollama"):
        if not p and os.path.exists(c):
            p = c
    return p


def start_server():
    if server_up():
        return True
    ob = ollama_bin()
    if not ob:
        return False
    if shutil.which("brew") and "/homebrew/" in ob:
        subprocess.call(["brew", "services", "start", "ollama"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(20):
        if server_up():
            return True
        time.sleep(0.5)
    subprocess.Popen([ob, "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(40):
        if server_up():
            return True
        time.sleep(0.5)
    return False


def pull(tag):
    ob = ollama_bin()
    if not ob:
        die("ollama is not installed. Run: jev setup")
    if not start_server():
        die("could not start the Ollama server")
    return subprocess.call([ob, "pull", tag])


def cmd_setup(a):
    if not ollama_bin():
        if not shutil.which("brew"):
            die("Ollama is missing and Homebrew is not installed. Get Ollama from https://ollama.com/download")
        print("Installing Ollama with Homebrew…")
        if subprocess.call(["brew", "install", "ollama"]) != 0:
            die("brew install ollama failed")
    if not start_server():
        die("could not start the Ollama server (try: ollama serve)")
    model = resolve(a.model) if a.model else default_model()
    if not has_model(model, installed_models()):
        print("Pulling %s …" % model)
        if pull(model) != 0:
            die("pull failed")
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    cfg = load_config()
    cfg["model"] = model
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)
    print("Ready. Default model: %s\nTry: jev yesno --state 'The build is green' --statement 'The tests pass'" % model)


def cmd_pull(a):
    tags = [resolve(t) for t in a.models]
    if a.all:
        tags = [m["id"] for m in CATALOG]
    for t in tags:
        print("→ " + t)
        if pull(t) != 0:
            die("pull failed: " + t)


def cmd_doctor(a):
    ok = True
    ob = ollama_bin()
    print("ollama binary : %s" % (ob or "MISSING  → jev setup"))
    up = server_up()
    print("server        : %s" % ("up at " + HOST if up else "DOWN     → jev setup"))
    inst = installed_models() if up else []
    r = ram_gb()
    print("memory        : %.0f GB  (default model: %s)" % (r, default_model()))
    free = shutil.disk_usage(os.path.expanduser("~")).free / 2 ** 30
    print("disk free     : %.0f GB" % free)
    mine = [m["id"] for m in CATALOG if has_model(m["id"], inst)]
    print("decision models installed: %s" % (", ".join(mine) or "none  → jev pull default"))
    if up and has_model(default_model(), inst):
        t = time.time()
        try:
            res = do_noul(default_model(), "The sky is blue.", "The sky is blue.")
            print("self-test     : noul=%.3f conf=%.3f in %d ms  %s" % (
                res.get("noul") or -1, res.get("confidence") or -1, (time.time() - t) * 1000,
                "(logprobs OK)" if res.get("label_mass", 0) > 0.5 else "(NO LOGPROBS — update Ollama: brew upgrade ollama)"))
        except SystemExit:
            ok = False
    else:
        ok = False
    sys.exit(0 if ok and ob and up else 1)


# --------------------------------------------------------------------------
# Claude Code PreToolUse hook: conservative permission gate (opt-in).
# --------------------------------------------------------------------------
HARD_ASK = [
    r"\brm\s+(-[a-zA-Z]*r[a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*r)\b", r"\bsudo\b", r"\bgit\s+push\b.*(--force|-f\b)",
    r"\bgit\s+reset\s+--hard\b", r"\bcurl\b.*\|\s*(sh|bash|zsh)\b", r"\bchmod\s+-R\b", r"\bmkfs\b", r"\bdd\s+if=",
    r">\s*/dev/(sd|disk)", r"\bdrop\s+(table|database)\b", r"\bnpm\s+publish\b", r"\bwrangler\s+(deploy|delete)\b",
    r"\bgit\s+push\b", r"\.env\b", r"\bkeychain\b|\bsecurity\s+find-", r"\bssh\b|\bscp\b",
]
SAFE_READ = re.compile(r"^\s*(ls|cat|head|tail|wc|pwd|echo|grep|rg|find|stat|file|which|git\s+(status|log|diff|show|branch)|"
                       r"sed\s+-n|awk|sort|uniq|jq|tree|du|df)\b")


def hook_decision(reason, allow=False):
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                   "permissionDecision": "allow" if allow else "ask",
                                   "permissionDecisionReason": reason}}


def cmd_hook(a):
    if a.print_config:
        me = os.path.abspath(sys.argv[0])
        print(json.dumps({"hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
            {"type": "command", "command": me + " hook", "timeout": 20}]}]}}, indent=2))
        return
    try:
        ev = json.load(sys.stdin)
    except Exception:
        sys.exit(0)
    if ev.get("tool_name") != "Bash":
        sys.exit(0)
    cmd = (ev.get("tool_input") or {}).get("command", "")
    if any(re.search(p, cmd, re.I) for p in HARD_ASK):
        print(json.dumps(hook_decision("jev: matches a never-auto-approve pattern; asking you.")))
        sys.exit(0)
    if "&&" not in cmd and ";" not in cmd and "|" not in cmd and ">" not in cmd and SAFE_READ.match(cmd):
        print(json.dumps(hook_decision("jev: plain read-only command.", allow=True)))
        sys.exit(0)
    if not server_up() or not has_model(default_model(), installed_models()):
        sys.exit(0)  # no local model: stay out of the way, normal prompt applies
    try:
        r = do_choice(default_model(), {"shell_command": cmd, "cwd": ev.get("cwd", "")},
                      "What is the worst effect of running this command?",
                      {"read_only": "only reads or prints; changes nothing",
                       "local_edit": "creates or edits files inside the project directory",
                       "risky": "changes things outside the project, installs software, uses the network to send data, or is hard to undo",
                       "destructive": "deletes data, overwrites history, or could cause loss"}, debias=True)
    except SystemExit:
        sys.exit(0)
    c = r.get("choice")
    if c == "read_only" and r["probabilities"]["read_only"] >= a.threshold and r["confidence"] >= 0.7:
        print(json.dumps(hook_decision("jev: read-only (p=%.2f)." % r["probabilities"]["read_only"], allow=True)))
    elif c in ("risky", "destructive"):
        print(json.dumps(hook_decision("jev: judged %s (p=%.2f); asking you." % (c, r["probabilities"][c]))))
    sys.exit(0)


def build_parser():
    p = argparse.ArgumentParser(prog="jev", description="Local System One decision engine for Claude Code.")
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp, state=True):
        if state:
            sp.add_argument("--state", help="the text/JSON to judge (or pipe it on stdin)")
            sp.add_argument("--state-file")
        sp.add_argument("--model", help="tag or shortcut (tiny, fast, default, best)")
        sp.add_argument("--instructions", help="extra standing instructions for the decision")
        sp.add_argument("--min-confidence", type=float, help="below this: action=escalate, exit code 3")

    s = sub.add_parser("choose", help="pick one option, with probabilities and confidence")
    common(s)
    s.add_argument("--question", "-q", required=True)
    s.add_argument("--option", "-o", action="append", required=True, help="repeat; use name=description for hints")
    s.add_argument("--debias", action="store_true", help="also run reversed option order and average (2x cost)")
    s.set_defaults(fn=cmd_choose)

    s = sub.add_parser("score", help="rate on ordered levels (0..n-1) -> expected score")
    common(s)
    s.add_argument("--question", "-q", required=True)
    s.add_argument("--level", "-l", action="append", required=True, help="repeat in order, lowest first")
    s.set_defaults(fn=cmd_score)

    s = sub.add_parser("yesno", help="probability that a statement is true of the state")
    common(s)
    s.add_argument("--statement", "-s", required=True)
    s.set_defaults(fn=cmd_yesno)

    s = sub.add_parser("ask", help="batch: many typed questions about one state, in parallel (JSON on stdin)")
    common(s, state=False)
    s.add_argument("--file")
    s.add_argument("--parallel", type=int, default=3)
    s.add_argument("--debias", action="store_true")
    s.set_defaults(fn=cmd_ask)

    s = sub.add_parser("panel", help="ensemble several local models on one choice")
    common(s)
    s.add_argument("--models", help="comma list; default: default + gemma3:4b + granite3.3:8b")
    s.add_argument("--question", "-q", required=True)
    s.add_argument("--option", "-o", action="append", required=True)
    s.set_defaults(fn=cmd_panel)

    s = sub.add_parser("guard", help="Granite Guardian risk probability (harm, jailbreak, social_bias, violence…)")
    common(s)
    s.add_argument("--risk", default="harm")
    s.set_defaults(fn=cmd_guard)

    s = sub.add_parser("think", help="System-2 escalation: slow reasoning model, prints the answer")
    s.add_argument("question", nargs="?")
    s.add_argument("--model")
    s.add_argument("--max-tokens", type=int, default=4096)
    s.add_argument("--show-thinking", action="store_true")
    s.set_defaults(fn=cmd_think)

    s = sub.add_parser("bench", help="accuracy / confidence / latency of models on a built-in routing set")
    s.add_argument("--models", help="comma list; default: the default model")
    s.add_argument("--bare", action="store_true", help="options without descriptions (shows how much hints matter)")
    s.add_argument("--debias", action="store_true", help="reversed-order averaging, as `choose --debias`")
    s.set_defaults(fn=cmd_bench)

    sub.add_parser("models", help="the ten decision models and what fits this Mac").set_defaults(fn=cmd_models)
    s = sub.add_parser("pull", help="download models (tags or shortcuts)")
    s.add_argument("models", nargs="*")
    s.add_argument("--all", action="store_true", help="every model in the catalog (~50 GB)")
    s.set_defaults(fn=cmd_pull)
    s = sub.add_parser("setup", help="install Ollama, start it, pull the default model")
    s.add_argument("--model")
    s.set_defaults(fn=cmd_setup)
    sub.add_parser("doctor", help="check the install and run a self-test").set_defaults(fn=cmd_doctor)

    s = sub.add_parser("hook", help="Claude Code PreToolUse permission gate (reads the event JSON on stdin)")
    s.add_argument("--print-config", action="store_true", help="print the settings.json snippet and exit")
    s.add_argument("--threshold", type=float, default=0.9)
    s.set_defaults(fn=cmd_hook)
    return p


def main():
    a = build_parser().parse_args()
    if getattr(a, "option", None):  # name=description sugar
        opts = {}
        for o in a.option:
            k, _, v = o.partition("=")
            opts[k] = v
        a.option = opts if any(opts.values()) else list(opts.keys())
    if getattr(a, "level", None):
        lv = {}
        for o in a.level:
            k, _, v = o.partition("=")
            lv[k] = v
        a.level = lv if any(lv.values()) else list(lv.keys())
    a.fn(a)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
