#!/usr/bin/env python3
"""jev — local System One decision models for Claude Code.

A thin client + server manager for native *decision models* (vLLM-SR d3,
Perplexity Decider, Cloudflare Clef, Kev, Laya, LiquidAI d1 ...) served by
llama.cpp's TypeSafe-compatible `POST /v1/systemone` endpoint. A decision model
does not generate text: one forward pass returns a typed answer (choice /
score / noul) with calibrated probabilities and a confidence.

Python 3.9+, standard library only.
"""
import argparse
import concurrent.futures as cf
import glob
import json
import math
import os
import platform
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

PORT = int(os.environ.get("JEV_PORT", "9931"))
URL = os.environ.get("JEV_URL", "http://127.0.0.1:%d" % PORT).rstrip("/")
HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".local/state/local-jev")
SHARE_DIR = os.path.join(HOME, ".local/share/local-jev")
CONFIG = os.path.join(HOME, ".config/local-jev/config.json")
HF_CACHE = os.environ.get("HF_HUB_CACHE") or os.path.join(os.environ.get("HF_HOME", os.path.join(HOME, ".cache/huggingface")), "hub")

# --------------------------------------------------------------------------
# Catalog: the ten best open decision models you can run locally.
# `index` = Decision Index 0.3 "v" score (huggingface.co/spaces/multimodalart/jev-decision-index,
# board of 2026-10-06; TypeSafe's hosted Jev 1.13 scores 60.1 on the same board).
# --------------------------------------------------------------------------
