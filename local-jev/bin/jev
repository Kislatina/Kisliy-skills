ALIASES = {"default": "d3-flash", "best": "d3", "fast": "d3-mini", "tiny": "laya", "multilingual": "laya",
           "reflex": "d1-3b", "perplexity": "pplx", "clef": "clef-flash", "kev": "kev-9b"}


def die(msg, code=1):
    print("jev: " + msg, file=sys.stderr)
    sys.exit(code)


def ram_gb():
    try:
        if sys.platform == "darwin":
            return int(subprocess.check_output(["sysctl", "-n", "hw.memsize"]).strip()) / 2 ** 30
        with open("/proc/meminfo") as f:
            return int(f.readline().split()[1]) / 2 ** 20
    except Exception:
        return 0.0


def entry(name):
    name = ALIASES.get(name, name)
    for m in CATALOG:
        if m["key"] == name or m["repo"].lower() == name.lower():
            return m
    die("unknown model '%s'. See: jev models" % name)


def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except Exception:
        return {}


def default_key():
    if os.environ.get("JEV_MODEL"):
        return entry(os.environ["JEV_MODEL"])["key"]
    cfg = load_config().get("model")
    if cfg and any(m["key"] == cfg for m in CATALOG):
        return cfg
    r = ram_gb()
    if r >= 30:
        return "d3"
    if r >= 11:
        return "d3-flash"
    if r >= 7:
        return "d3-mini"
    return "d3-nano"


def cached(m):
    d = os.path.join(HF_CACHE, "models--" + m["repo"].replace("/", "--"), "snapshots")
    want = m.get("file") or ("-" + m.get("quant", "") + ".gguf")
    for p in glob.glob(os.path.join(d, "*", "*.gguf")):
        b = os.path.basename(p)
        if "mmproj" in b:
            continue
        if (m.get("file") and b == m["file"]) or (not m.get("file") and b.endswith(want)):
            return True
    return False


# --------------------------------------------------------------------------
# Server management (llama.cpp llama-server with /v1/systemone)
# --------------------------------------------------------------------------
def llama_server_bin():
    if os.environ.get("JEV_LLAMA_SERVER"):
        return os.environ["JEV_LLAMA_SERVER"]
    found = sorted(glob.glob(os.path.join(SHARE_DIR, "llama-*", "**", "llama-server"), recursive=True), reverse=True)
    if found:
        return found[0]
    return shutil.which("llama-server")


def http(path, body=None, timeout=60):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(URL + path, data=data, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def healthy():
    try:
        return http("/health", timeout=2).get("status") == "ok"
    except Exception:
        return False


def running_info():
    try:
        with open(os.path.join(STATE_DIR, "server.json")) as f:
            return json.load(f)
    except Exception:
        return {}


def stop_server():
    info = running_info()
    pid = info.get("pid")
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(40):
            try:
                os.kill(pid, 0)
                time.sleep(0.25)
            except OSError:
                break
    try:
        os.remove(os.path.join(STATE_DIR, "server.json"))
    except OSError:
        pass


def start_server(m, quiet=False, wait=1800):
    exe = llama_server_bin()
    if not exe:
        die("no llama-server found. Run: jev setup")
    if "localhost" not in URL and "127.0.0.1" not in URL:
        die("JEV_URL points to a remote server; start the model there")
    os.makedirs(STATE_DIR, exist_ok=True)
    stop_server()
    cmd = [exe, "--host", "127.0.0.1", "--port", str(PORT), "--alias", "jev",
           "--ubatch-size", "4096", "--batch-size", "4096", "-c", "8192"]
    if not os.environ.get("JEV_MMPROJ"):  # text-only by default: saves RAM and a download
        cmd.append("--no-mmproj")
    if m.get("file"):
        cmd += ["-hf", m["repo"], "--hf-file", m["file"]]
    else:
        cmd += ["-hf", "%s:%s" % (m["repo"], m["quant"])]
    cmd += os.environ.get("JEV_SERVER_ARGS", "").split()
    log = os.path.join(STATE_DIR, "server.log")
    lf = open(log, "w")
    p = subprocess.Popen(cmd, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
    with open(os.path.join(STATE_DIR, "server.json"), "w") as f:
        json.dump({"pid": p.pid, "key": m["key"], "repo": m["repo"], "started": time.time()}, f)
    t0, last = time.time(), 0
    while time.time() - t0 < wait:
        if p.poll() is not None:
            tail = open(log).read()[-600:]
            hint = " Update the runtime: jev setup --update" if "unsupported decision model" in tail else ""
            die("llama-server exited while loading %s.%s\n%s" % (m["key"], hint, tail))
        if healthy():
            return
        if not quiet and time.time() - last > 15:
            last = time.time()
            print("… loading %s (first run downloads %.1f GB)" % (m["name"], m["gb"]), file=sys.stderr)
        time.sleep(1)
    die("timed out waiting for the server; see " + log)


def ensure(model=None):
    """Make sure a server with the wanted model answers; start/switch it if needed."""
    if "localhost" not in URL and "127.0.0.1" not in URL:
        if not healthy():
            die("remote server %s is not reachable" % URL, 4)
        return
    want = entry(model) if model else None
    info = running_info()
    if healthy() and (want is None or info.get("key") in (None, want["key"])):
        return
    m = want or entry(default_key())
    start_server(m)


def call(state, questions, model=None, files=None):
    ensure(model)
    body = {"state": state, "questions": questions}
    if files:
        body["files"] = files
    try:
        return http("/v1/systemone", body, timeout=300)
    except urllib.error.HTTPError as e:
        die("server error %s: %s" % (e.code, e.read().decode("utf-8", "replace")[:400]))
    except urllib.error.URLError as e:
        die("cannot reach %s (%s). Run: jev serve" % (URL, e.reason), 4)


# --------------------------------------------------------------------------
# Primitives
# --------------------------------------------------------------------------
def conf_choice(ps):
    n = len(ps)
    return max(0.0, min(1.0, (n * max(ps) - 1) / (n - 1))) if n > 1 else 1.0


def norm_options(options):
    if isinstance(options, dict):
        return {str(k): (str(v) if v else None) for k, v in options.items()}
    return {str(o): None for o in options}


def q_choice(question, options, instructions=None):
    q = {"type": "choice", "instructions": question, "criteria": norm_options(options)}
    if instructions:
        q["instructions"] = question + "\n" + instructions
    return q


def q_score(question, levels, instructions=None):
    lv = list(levels.keys()) if isinstance(levels, dict) else list(levels)
    if isinstance(levels, dict):
        lv = ["%s: %s" % (k, v) if v else k for k, v in levels.items()]
    q = {"type": "score", "instructions": question, "criteria": lv}
    if instructions:
        q["instructions"] = question + "\n" + instructions
    return q


def q_noul(statement, instructions=None):
    q = {"type": "noul", "instructions": statement}
    if instructions:
        q["instructions"] = statement + "\n" + instructions
    return q


def tidy(qid, ans):
    t = ans.get("type")
    if t == "choice":
        out = {"type": "choice", "choice": ans["choice"],
               "probabilities": {k: round(v, 4) for k, v in ans["probabilities"].items()},
               "confidence": round(ans.get("confidence", conf_choice(list(ans["probabilities"].values()))), 4)}
    elif t == "score":
        ps = [ans["probabilities"][k] for k in sorted(ans["probabilities"], key=int)]
        out = {"type": "score", "score": round(ans["score"], 3), "level": ps.index(max(ps)),
               "legend": ans.get("legend"), "probabilities": {k: round(v, 4) for k, v in ans["probabilities"].items()},
               "confidence": round(ans.get("confidence", 0.0), 4)}
    else:
        p = ans.get("noul", ans.get("probability"))
        out = {"type": "noul", "noul": round(p, 4), "answer": p >= 0.5, "confidence": round(abs(2 * p - 1), 4)}
    if qid:
        out["id"] = qid
    return out


def gate(out, min_conf):
    if min_conf is not None:
        out["action"] = "act" if out.get("confidence", 0) >= min_conf else "escalate"
    return out


def emit(obj, code=0):
    print(json.dumps(obj, ensure_ascii=False, indent=2))
    sys.exit(code)


def read_state(a):
    if getattr(a, "state_file", None):
        txt = open(a.state_file).read()
    elif getattr(a, "state", None) is not None:
        txt = a.state
    elif not sys.stdin.isatty():
        txt = sys.stdin.read()
    else:
        die("no state: pass --state, --state-file or pipe it on stdin")
    try:
        v = json.loads(txt)
        if isinstance(v, (dict, list)):
            return v
    except Exception:
        pass
    return txt


def one(a, question):
    state = read_state(a)
    res = call(state, {"q": question}, a.model)
    out = gate(tidy(None, res["answers"]["q"]), a.min_confidence)
    out["model"] = (running_info().get("key") or a.model or default_key())
    emit(out, 3 if out.get("action") == "escalate" else 0)


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
def cmd_choose(a):
    one(a, q_choice(a.question, a.option, a.instructions))


def cmd_score(a):
    one(a, q_score(a.question, a.level, a.instructions))


def cmd_yesno(a):
    one(a, q_noul(a.statement, a.instructions))


def cmd_ask(a):
    """Batch. Accepts TypeSafe-native {"state", "questions":{id:{...}}} or the list form."""
    spec = json.load(open(a.file)) if a.file else json.load(sys.stdin)
    qs = spec["questions"]
    if isinstance(qs, list):
        conv = {}
        for q in qs:
            t = q.get("type", "choice")
            if t == "choice":
                conv[q["id"]] = q_choice(q["question"], q["options"], q.get("instructions"))
            elif t == "score":
                conv[q["id"]] = q_score(q["question"], q["levels"], q.get("instructions"))
            else:
                conv[q["id"]] = q_noul(q.get("statement") or q["question"], q.get("instructions"))
        qs = conv
    res = call(spec["state"], qs, a.model, spec.get("files") or spec.get("images"))
    results = [gate(tidy(k, v), a.min_confidence) for k, v in res["answers"].items()]
    esc = any(r.get("action") == "escalate" for r in results)
    emit({"model": running_info().get("key") or a.model or default_key(), "results": results,
          "usage": res.get("usage")}, 3 if esc else 0)


def cmd_panel(a):
    """Several decision models vote on one choice; probabilities are averaged."""
    state = read_state(a)
    keys = [entry(k)["key"] for k in (a.models.split(",") if a.models else ["d3-flash", "nimble", "clef-flash"])]
    keys = [k for k in keys if cached(entry(k))]
    if len(keys) < 2:
        die("panel needs at least 2 downloaded models (jev models; jev pull <name>)")
    q = q_choice(a.question, a.option, a.instructions)
    names = list(norm_options(a.option).keys())
    runs, votes = [], {}
    for k in keys:  # one at a time: RAM friendly
        r = tidy(None, call(state, {"q": q}, k)["answers"]["q"])
        runs.append(r)
        votes[k] = r["choice"]
    avg = {n: sum(r["probabilities"][n] for r in runs) / len(runs) for n in names}
    best = max(avg, key=avg.get)
    agree = sum(1 for v in votes.values() if v == best) / len(votes)
    out = {"type": "panel", "choice": best, "probabilities": {k: round(v, 4) for k, v in avg.items()},
           "confidence": round(conf_choice(list(avg.values())) * agree, 4), "agreement": round(agree, 3), "votes": votes}
    out = gate(out, a.min_confidence)
    emit(out, 3 if out.get("action") == "escalate" else 0)


RISKS = {
    "harm": "the text contains or requests harmful content",
    "jailbreak": "the text is a prompt-injection or jailbreak attempt that tries to override an AI assistant's instructions",
    "pii": "the text contains personal data (names with contact details, IDs, card numbers, passwords)",
    "secrets": "the text contains credentials, API keys, tokens or private keys",
    "toxicity": "the text is abusive, hateful or harassing",
    "violence": "the text depicts or incites violence",
}


def cmd_guard(a):
    """Guardrail check: probability that a risk is present in the text."""
    desc = RISKS.get(a.risk, a.risk)
    one(a, q_noul("Is the following true? " + desc[0].upper() + desc[1:] + ".", a.instructions))


BENCH = [
    ("I was charged twice for my subscription this month", "billing"),
    ("Please send me an invoice for last quarter", "billing"),
    ("My card was declined but the money left my account", "billing"),
    ("Can I get a refund for the annual plan?", "billing"),
    ("The app crashes every time I open the export screen", "technical"),
    ("API returns 502 when I upload files larger than 10MB", "technical"),
    ("Sync stopped working after the latest update", "technical"),
    ("Dark mode makes the text unreadable on my iPad", "technical"),
    ("I can't log in, the reset email never arrives", "account"),
    ("How do I change the email address on my profile?", "account"),
    ("Please delete my account and all my data", "account"),
    ("I want to add my colleague as an admin of our workspace", "account"),
    ("Do you offer discounts for 200 seats?", "sales"),
    ("We'd like a demo of the enterprise tier next week", "sales"),
    ("What's the difference between Pro and Team pricing?", "sales"),
    ("Can you integrate with our SSO provider? We're evaluating vendors", "sales"),
]


def cmd_bench(a):
    opts = {"billing": "charges, invoices, payments, refunds", "technical": "bugs, crashes, errors, performance",
            "account": "login, profile, permissions, data deletion", "sales": "pricing, demos, plans, evaluation"}
    if a.bare:
        opts = list(opts)
    keys = [entry(k)["key"] for k in a.models.split(",")] if a.models else [running_info().get("key") or default_key()]
    rows = []
    for k in keys:
        ensure(k)
        ok, confs, hi_n, hi_ok = 0, [], 0, 0
        t0 = time.time()
        for text, gold in BENCH:
            r = tidy(None, call(text, {"q": q_choice("Which team should handle this customer message?", opts)}, k)["answers"]["q"])
            good = r["choice"] == gold
            ok += good
            confs.append(r["confidence"])
            if r["confidence"] >= 0.7:
                hi_n += 1
                hi_ok += good
        rows.append({"model": k, "accuracy": round(ok / len(BENCH), 3),
                     "mean_confidence": round(sum(confs) / len(confs), 3),
                     "accuracy_when_conf>=0.7": round(hi_ok / hi_n, 3) if hi_n else None,
                     "ms_per_decision": round((time.time() - t0) * 1000 / len(BENCH))})
    emit({"items": len(BENCH), "results": rows})


def cmd_models(a):
    r = ram_gb()
    run = running_info().get("key") if healthy() else None
    print("This machine: %.0f GB RAM    default: %s    running: %s\n" % (r, default_key(), run or "—"))
    print("%-3s %-11s %-30s %6s %7s %5s  %-9s %s" % ("", "KEY", "MODEL", "INDEX", "SIZE", "RAM", "STATUS", "WHAT IT IS FOR"))
    for m in CATALOG:
        st = "running" if m["key"] == run else ("downloaded" if cached(m) else "")
        fit = "" if r >= m["ram"] else " (needs %d GB)" % m["ram"]
        star = "★" if m["key"] == default_key() else " "
        print("%-3s %-11s %-30s %6.1f %5.1fGB %3dGB  %-10s %s%s" % (star, m["key"], m["name"], m["index"], m["gb"], m["ram"], st, m["why"], fit))
    print("\nINDEX = Decision Index 0.3 (higher is better; hosted TypeSafe Jev 1.13 = 60.1).")
    print("Shortcuts: " + ", ".join("%s→%s" % kv for kv in ALIASES.items()))


def fetch_runtime(update=False):
    if llama_server_bin() and not update and glob.glob(os.path.join(SHARE_DIR, "llama-*")):
        return
    sysname, mach = sys.platform, platform.machine().lower()
    if sysname == "darwin":
        needle = "macos-arm64.tar.gz" if "arm" in mach else "macos-x64.tar.gz"
    else:
        needle = "ubuntu-x64.tar.gz"
    print("→ looking up the latest llama.cpp release…")
    rel = json.loads(urllib.request.urlopen("https://api.github.com/repos/ggml-org/llama.cpp/releases/latest", timeout=30).read())
    asset = next((x for x in rel["assets"] if x["name"].endswith(needle) and "bin" in x["name"]), None)
    if not asset:
        die("no prebuilt llama.cpp for this platform; build from source and set JEV_LLAMA_SERVER")
    dest = os.path.join(SHARE_DIR, "llama-" + rel["tag_name"])
    if os.path.isdir(dest) and glob.glob(os.path.join(dest, "**", "llama-server"), recursive=True):
        return
    os.makedirs(dest, exist_ok=True)
    print("→ downloading %s (%.0f MB)" % (asset["name"], asset["size"] / 1e6))
    with tempfile.TemporaryDirectory() as tmp:
        arc = os.path.join(tmp, "llama.tar.gz")
        urllib.request.urlretrieve(asset["browser_download_url"], arc)
        if subprocess.call(["tar", "-xzf", arc, "-C", dest]) != 0:
            die("could not unpack the llama.cpp archive")
    print("✓ runtime in " + dest)


def cmd_setup(a):
    fetch_runtime(a.update)
    m = entry(a.model) if a.model else entry(default_key())
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    cfg = load_config()
    cfg["model"] = m["key"]
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)
    if a.no_pull:
        print("Runtime ready. Download a model with: jev pull %s" % m["key"])
        return
    print("→ model: %s (%.1f GB, %s)" % (m["name"], m["gb"], m["license"]))
    start_server(m)
    print("✓ ready. Try:  jev yesno -s 'The customer is angry' --state 'This is the third time I write. Unacceptable!'")


def cmd_pull(a):
    fetch_runtime()
    keys = [m["key"] for m in CATALOG] if a.all else [entry(k)["key"] for k in a.models]
    if not keys:
        die("name a model, e.g. jev pull d3-mini  (see: jev models)")
    prev = running_info().get("key") if healthy() else None
    for k in keys:
        m = entry(k)
        if cached(m):
            print("✓ %s already downloaded" % k)
            continue
        print("→ %s (%.1f GB)" % (k, m["gb"]))
        start_server(m)
    if prev and prev != keys[-1]:
        start_server(entry(prev), quiet=True)


def cmd_serve(a):
    fetch_runtime()
    m = entry(a.model) if a.model else entry(default_key())
    start_server(m)
    print("✓ %s serving on %s  (POST /v1/systemone, TypeSafe-compatible)" % (m["key"], URL))


def cmd_stop(a):
    stop_server()
    print("stopped")


def cmd_status(a):
    info = running_info()
    print(json.dumps({"url": URL, "up": healthy(), "model": info.get("key"), "pid": info.get("pid"),
                      "runtime": llama_server_bin()}, indent=2))


def cmd_doctor(a):
    ok = True
    exe = llama_server_bin()
    print("runtime       : %s" % (exe or "MISSING  → jev setup"))
    ok &= bool(exe)
    print("memory        : %.0f GB  (default model: %s)" % (ram_gb(), default_key()))
    print("disk free     : %.0f GB" % (shutil.disk_usage(HOME).free / 2 ** 30))
    have = [m["key"] for m in CATALOG if cached(m)]
    print("downloaded    : %s" % (", ".join(have) or "none  → jev setup"))
    up = healthy()
    print("server        : %s" % (("up, model=%s" % running_info().get("key")) if up else "down (auto-starts on first decision)"))
    if up:
        t = time.time()
        try:
            r = call("The sky is blue.", {"q": q_noul("The sky is blue.")})
            print("self-test     : noul=%.3f in %d ms" % (r["answers"]["q"]["noul"], (time.time() - t) * 1000))
        except SystemExit:
            ok = False
    sys.exit(0 if ok else 1)


# --------------------------------------------------------------------------
# Claude Code PreToolUse hook: conservative permission gate (opt-in).
# --------------------------------------------------------------------------
HARD_ASK = [
    r"\brm\s+(-[a-zA-Z]*r[a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*r)\b", r"\bsudo\b", r"\bgit\s+push\b", r"\bgit\s+reset\s+--hard\b",
    r"\bcurl\b.*\|\s*(sh|bash|zsh)\b", r"\bchmod\s+-R\b", r"\bmkfs\b", r"\bdd\s+if=", r">\s*/dev/(sd|disk)",
    r"\bdrop\s+(table|database)\b", r"\bnpm\s+publish\b", r"\bwrangler\s+(deploy|delete)\b", r"\.env\b",
    r"\bkeychain\b|\bsecurity\s+find-", r"\bssh\b|\bscp\b",
]
SAFE_READ = re.compile(r"^\s*(ls|cat|head|tail|wc|pwd|echo|grep|rg|find|stat|file|which|git\s+(status|log|diff|show|branch)|"
                       r"sed\s+-n|awk|sort|uniq|jq|tree|du|df)\b")


def hook_out(reason, allow=False):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                             "permissionDecision": "allow" if allow else "ask",
                                             "permissionDecisionReason": reason}}))


def cmd_hook(a):
    if a.print_config:
        print(json.dumps({"hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
            {"type": "command", "command": os.path.abspath(sys.argv[0]) + " hook", "timeout": 30}]}]}}, indent=2))
        return
    try:
        ev = json.load(sys.stdin)
    except Exception:
        sys.exit(0)
    if ev.get("tool_name") != "Bash":
        sys.exit(0)
    cmd = (ev.get("tool_input") or {}).get("command", "")
    if any(re.search(p, cmd, re.I) for p in HARD_ASK):
        hook_out("jev: matches a never-auto-approve pattern; asking you.")
        sys.exit(0)
    if not re.search(r"&&|;|\||>|\$\(|`", cmd) and SAFE_READ.match(cmd):
        hook_out("jev: plain read-only command.", allow=True)
        sys.exit(0)
    if not healthy():  # never block on a cold model start inside a hook
        sys.exit(0)
    try:
        res = http("/v1/systemone", {
            "state": {"shell_command": cmd, "cwd": ev.get("cwd", "")},
            "questions": {"effect": q_choice("What is the worst effect of running this command?", {
                "read_only": "only reads or prints; changes nothing",
                "local_edit": "creates or edits files inside the project directory",
                "risky": "changes things outside the project, installs software, sends data over the network, or is hard to undo",
                "destructive": "deletes data, overwrites history, or could cause loss"})}}, timeout=20)
        r = tidy(None, res["answers"]["effect"])
    except Exception:
        sys.exit(0)
    p = r["probabilities"]
    if r["choice"] == "read_only" and p["read_only"] >= a.threshold and r["confidence"] >= 0.7:
        hook_out("jev: read-only (p=%.2f)." % p["read_only"], allow=True)
    elif r["choice"] in ("risky", "destructive"):
        hook_out("jev: judged %s (p=%.2f); asking you." % (r["choice"], p[r["choice"]]))
    sys.exit(0)


def build_parser():
    p = argparse.ArgumentParser(prog="jev", description="Local System One decision models for Claude Code.")
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp, state=True):
        if state:
            sp.add_argument("--state", help="the text/JSON to judge (or pipe it on stdin)")
            sp.add_argument("--state-file")
        sp.add_argument("--model", help="catalog key or shortcut (see: jev models)")
        sp.add_argument("--instructions", help="extra standing instructions for the question")
        sp.add_argument("--min-confidence", type=float, help="below this: action=escalate, exit code 3")

    s = sub.add_parser("choose", help="pick one option: probabilities + confidence")
    common(s)
    s.add_argument("--question", "-q", required=True)
    s.add_argument("--option", "-o", action="append", required=True, help="repeat; name=description gives a hint")
    s.set_defaults(fn=cmd_choose)

    s = sub.add_parser("score", help="rate on ordered levels (lowest first) -> expected score")
    common(s)
    s.add_argument("--question", "-q", required=True)
    s.add_argument("--level", "-l", action="append", required=True)
    s.set_defaults(fn=cmd_score)

    s = sub.add_parser("yesno", help="probability that a statement is true of the state")
    common(s)
    s.add_argument("--statement", "-s", required=True)
    s.set_defaults(fn=cmd_yesno)

    s = sub.add_parser("ask", help="batch: many typed questions about one state (JSON on stdin; TypeSafe format works)")
    common(s, state=False)
    s.add_argument("--file")
    s.set_defaults(fn=cmd_ask)

    s = sub.add_parser("panel", help="ensemble of decision models on one choice")
    common(s)
    s.add_argument("--models", help="comma list; default d3-flash,nimble,clef-flash")
    s.add_argument("--question", "-q", required=True)
    s.add_argument("--option", "-o", action="append", required=True)
    s.set_defaults(fn=cmd_panel)

    s = sub.add_parser("guard", help="guardrail: probability a risk is present (harm, jailbreak, pii, secrets, toxicity, violence, or free text)")
    common(s)
    s.add_argument("--risk", default="harm")
    s.set_defaults(fn=cmd_guard)

    s = sub.add_parser("bench", help="accuracy / confidence / latency on a built-in routing set")
    s.add_argument("--models")
    s.add_argument("--bare", action="store_true", help="options without descriptions")
    s.set_defaults(fn=cmd_bench)

    sub.add_parser("models", help="the ten decision models, Decision Index, what fits this Mac").set_defaults(fn=cmd_models)
    s = sub.add_parser("pull", help="download model(s)")
    s.add_argument("models", nargs="*")
    s.add_argument("--all", action="store_true")
    s.set_defaults(fn=cmd_pull)
    s = sub.add_parser("setup", help="fetch the llama.cpp runtime, pick a default model, download it, start serving")
    s.add_argument("--model")
    s.add_argument("--update", action="store_true", help="re-fetch the newest llama.cpp (new decision archs land often)")
    s.add_argument("--no-pull", action="store_true", help="runtime only")
    s.set_defaults(fn=cmd_setup)
    s = sub.add_parser("serve", help="(re)start the local /v1/systemone server with a model")
    s.add_argument("model", nargs="?")
    s.set_defaults(fn=cmd_serve)
    sub.add_parser("stop", help="stop the local server").set_defaults(fn=cmd_stop)
    sub.add_parser("status", help="server state").set_defaults(fn=cmd_status)
    sub.add_parser("doctor", help="check install, run a self-test").set_defaults(fn=cmd_doctor)

    s = sub.add_parser("hook", help="Claude Code PreToolUse permission gate (event JSON on stdin)")
    s.add_argument("--print-config", action="store_true")
    s.add_argument("--threshold", type=float, default=0.9)
    s.set_defaults(fn=cmd_hook)
    return p


def main():
    a = build_parser().parse_args()
    if getattr(a, "option", None):
        o = {}
        for x in a.option:
            k, _, v = x.partition("=")
            o[k] = v or None
        a.option = o
    if getattr(a, "level", None):
        o = {}
        for x in a.level:
            k, _, v = x.partition("=")
            o[k] = v or None
        a.level = o if any(o.values()) else list(o)
    a.fn(a)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
